            <latitude>25.776500</latitude>
            <altitude>110.0</altitude>
            <heading>311.6</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: Freedom Tower Landmark View -->
