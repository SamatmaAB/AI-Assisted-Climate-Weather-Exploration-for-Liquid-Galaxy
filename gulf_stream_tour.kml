        <!-- Scientific Stop: Cape Hatteras Coastal Separation -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-73.0</longitude>
            <latitude>35.0</latitude>
            <altitude>0.0</altitude>
            <heading>60.0</heading>
            <tilt>50.0</tilt>
