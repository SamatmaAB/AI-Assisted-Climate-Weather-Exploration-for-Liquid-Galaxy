        <!-- Final Settle Hold: Statue of Liberty Landmark View -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- Scientific Stop: North Atlantic Drift Crossing -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-35.0</longitude>
            <latitude>50.0</latitude>
            <altitude>0.0</altitude>
            <heading>75.0</heading>
            <tilt>55.0</tilt>
            <range>3500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: European Warming Drift to Norway -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>5.0</longitude>
            <latitude>60.0</latitude>
            <altitude>0.0</altitude>
            <heading>30.0</heading>
            <tilt>50.0</tilt>
            <range>2500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Big Ben Landmark View (London, UK) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
