            <altitude>80.0</altitude>
            <heading>141.7</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 6/6: Statue of Liberty Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-74.045442</longitude>
            <latitude>40.691363</latitude>
            <altitude>80.0</altitude>
            <heading>161.7</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
