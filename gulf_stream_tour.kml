<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
  <name>Gulf Stream Guided Tour</name>
  <open>1</open>
  <gx:Tour>
    <name>Gulf Stream Guided Tour</name>
    <gx:Playlist>

        <!-- Scientific Stop: North Atlantic Basin Overview -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-45.0</longitude>
            <latitude>35.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>9000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Gulf of Mexico & Florida Straits Origin -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-83.0</longitude>
            <latitude>24.0</latitude>
            <altitude>0.0</altitude>
            <heading>45.0</heading>
            <tilt>55.0</tilt>
            <range>2000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Freedom Tower Landmark View (Miami, USA) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
