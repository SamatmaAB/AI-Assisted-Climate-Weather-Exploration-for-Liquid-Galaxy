<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
  <name>La Niña Guided Tour</name>
  <open>1</open>
  <gx:Tour>
    <name>La Niña Guided Tour</name>
    <gx:Playlist>

        <!-- Scientific Stop: Pacific Basin Overview -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-160.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>12000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Cold Upwelling off South America -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-80.0</longitude>
            <latitude>-10.0</latitude>
            <altitude>0.0</altitude>
            <heading>315.0</heading>
            <tilt>55.0</tilt>
            <range>2500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Plaza Mayor of Lima View (Lima, Peru) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.032500</longitude>
            <latitude>-12.047000</latitude>
            <altitude>100.0</altitude>
            <heading>49.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: Plaza Mayor of Lima View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.032974</longitude>
            <latitude>-12.046228</latitude>
            <altitude>100.0</altitude>
            <heading>69.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 2/6: Plaza Mayor of Lima View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.033149</longitude>
            <latitude>-12.045345</latitude>
            <altitude>100.0</altitude>
            <heading>89.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 3/6: Plaza Mayor of Lima View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.033005</longitude>
            <latitude>-12.044456</latitude>
            <altitude>100.0</altitude>
            <heading>109.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 4/6: Plaza Mayor of Lima View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.032559</longitude>
            <latitude>-12.043669</latitude>
            <altitude>100.0</altitude>
            <heading>129.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 5/6: Plaza Mayor of Lima View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.031865</longitude>
            <latitude>-12.043079</latitude>
            <altitude>100.0</altitude>
            <heading>149.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 6/6: Plaza Mayor of Lima View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.031005</longitude>
            <latitude>-12.042756</latitude>
            <altitude>100.0</altitude>
            <heading>169.0</heading>
            <tilt>75.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Final Settle Hold: Plaza Mayor of Lima View -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- Scientific Stop: Strong Equatorial Trade Winds -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-150.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>270.0</heading>
            <tilt>50.0</tilt>
            <range>5500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Western Pacific Warm Pool & Heavy Rain -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>125.0</longitude>
            <latitude>-2.0</latitude>
            <altitude>0.0</altitude>
            <heading>240.0</heading>
            <tilt>50.0</tilt>
            <range>3500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Australian Wet Zone & Asian Monsoon -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>140.0</longitude>
            <latitude>-18.0</latitude>
            <altitude>0.0</altitude>
            <heading>330.0</heading>
            <tilt>45.0</tilt>
            <range>4000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Sydney Opera House Landmark View (Sydney, Australia) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.213000</longitude>
            <latitude>-33.859000</latitude>
            <altitude>100.0</altitude>
            <heading>41.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: Sydney Opera House Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.212233</longitude>
            <latitude>-33.858214</latitude>
            <altitude>100.0</altitude>
            <heading>61.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 2/6: Sydney Opera House Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.211835</longitude>
            <latitude>-33.857258</latitude>
            <altitude>100.0</altitude>
            <heading>81.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 3/6: Sydney Opera House Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.211856</longitude>
            <latitude>-33.856246</latitude>
            <altitude>100.0</altitude>
            <heading>101.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 4/6: Sydney Opera House Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.212292</longitude>
            <latitude>-33.855301</latitude>
            <altitude>100.0</altitude>
            <heading>121.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 5/6: Sydney Opera House Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.213090</longitude>
            <latitude>-33.854537</latitude>
            <altitude>100.0</altitude>
            <heading>141.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 6/6: Sydney Opera House Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>151.214156</longitude>
            <latitude>-33.854046</latitude>
            <altitude>100.0</altitude>
            <heading>161.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Final Settle Hold: Sydney Opera House Landmark View -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- Scientific Stop: Pacific Basin Conclusion -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-160.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>12000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

    </gx:Playlist>
  </gx:Tour>
</Document>
