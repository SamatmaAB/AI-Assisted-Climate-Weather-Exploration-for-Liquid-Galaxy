        </gx:FlyTo>

        <!-- Landmark Approach: Golden Gate Bridge View (San Francisco, USA) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.481500</longitude>
            <latitude>37.817000</latitude>
            <altitude>150.0</altitude>
            <heading>41.1</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
