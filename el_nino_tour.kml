        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-77.031865</longitude>
            <latitude>-12.043079</latitude>
            <altitude>100.0</altitude>
