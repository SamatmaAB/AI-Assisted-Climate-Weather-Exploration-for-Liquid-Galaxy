<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
  <name>El Niño Guided Tour</name>
  <open>1</open>
  <gx:Tour>
    <name>El Niño Guided Tour</name>
    <gx:Playlist>

        <!-- Scientific Stop: Pacific Overview -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-160.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>12000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Western Pacific Warm Pool & Indonesia Drought -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>120.0</longitude>
            <latitude>-3.0</latitude>
            <altitude>0.0</altitude>
            <heading>30.0</heading>
            <tilt>50.0</tilt>
            <range>3500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Monas National Monument View (Jakarta, Indonesia) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>106.825000</longitude>
            <latitude>-6.177500</latitude>
            <altitude>120.0</altitude>
            <heading>46.2</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: Monas National Monument View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>106.824410</longitude>
            <latitude>-6.176625</latitude>
            <altitude>120.0</altitude>
            <heading>66.2</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
