            <altitude>80.0</altitude>
            <heading>110.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 2/6: India Gate Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>77.227585</longitude>
