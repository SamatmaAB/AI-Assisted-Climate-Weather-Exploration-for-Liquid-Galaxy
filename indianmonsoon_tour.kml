<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
  <name>Indian Monsoon Guided Tour</name>
  <open>1</open>
  <gx:Tour>
    <name>Indian Monsoon Guided Tour</name>
    <gx:Playlist>

        <!-- Scientific Stop: South Asian Monsoon Overview -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>78.0</longitude>
            <latitude>20.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>5000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Arabian Sea Branch & Western Ghats -->
        <gx:FlyTo>
          <gx:duration>10.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>70.0</longitude>
            <latitude>14.0</latitude>
            <altitude>0.0</altitude>
            <heading>45.0</heading>
            <tilt>55.0</tilt>
            <range>2200000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Gateway of India Landmark View (Mumbai, India) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>72.832500</longitude>
            <latitude>18.922000</latitude>
            <altitude>70.0</altitude>
            <heading>90.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: Gateway of India Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>72.832633</longitude>
            <latitude>18.922712</latitude>
            <altitude>70.0</altitude>
            <heading>110.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 2/6: Gateway of India Landmark View -->
