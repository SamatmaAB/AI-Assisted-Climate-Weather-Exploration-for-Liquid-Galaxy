            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Final Settle Hold: Gateway of India Landmark View -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- Scientific Stop: Bay of Bengal Branch Inflow -->
        <gx:FlyTo>
          <gx:duration>10.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>88.0</longitude>
            <latitude>16.0</latitude>
            <altitude>0.0</altitude>
            <heading>15.0</heading>
            <tilt>50.0</tilt>
            <range>2500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Northeast India & Cherrapunji Heavy Rain -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>91.5</longitude>
            <latitude>25.5</latitude>
            <altitude>0.0</altitude>
            <heading>315.0</heading>
            <tilt>60.0</tilt>
            <range>1800000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Gangetic Plain Monsoon Trough & Low Pressure -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>76.0</longitude>
            <latitude>27.0</latitude>
            <altitude>0.0</altitude>
            <heading>270.0</heading>
            <tilt>50.0</tilt>
            <range>2000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: India Gate Landmark View (New Delhi, India) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
