            <altitude>80.0</altitude>
            <heading>90.0</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: India Gate Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>77.227151</longitude>
