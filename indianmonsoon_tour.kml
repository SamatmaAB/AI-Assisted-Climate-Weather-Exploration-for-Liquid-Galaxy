        <!-- Partial Orbit Keyframe 4/6: Gateway of India Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>72.834318</longitude>
