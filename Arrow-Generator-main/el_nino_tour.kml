<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
  <name>El Niño Guided Tour</name>
  <open>1</open>
  <gx:Tour>
    <name>El Niño Guided Tour</name>
    <gx:Playlist>

        <!-- Stop: Pacific Overview -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-160.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>12000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Stop: Western Pacific Warm Pool & Indonesia Drought -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>120.0</longitude>
            <latitude>-3.0</latitude>
            <altitude>0.0</altitude>
            <heading>30.0</heading>
            <tilt>50.0</tilt>
            <range>3500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Stop: Equatorial Pacific Heat Conveyor -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-140.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>90.0</heading>
            <tilt>55.0</tilt>
            <range>5000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Stop: Peru Upwelling & Coastal Flooding -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-78.0</longitude>
            <latitude>-9.0</latitude>
            <altitude>0.0</altitude>
            <heading>45.0</heading>
            <tilt>60.0</tilt>
            <range>2500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Stop: North American Teleconnections -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-105.0</longitude>
            <latitude>32.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>4500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Stop: Pacific Basin Conclusion -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-160.0</longitude>
            <latitude>0.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>12000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

    </gx:Playlist>
  </gx:Tour>
</Document>
</kml>
