        </gx:FlyTo>

        <!-- Final Settle Hold: Tokyo Tower Landmark View -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- Scientific Stop: North Pacific Drift Outer Reach -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>158.0</longitude>
            <latitude>45.0</latitude>
            <altitude>0.0</altitude>
            <heading>75.0</heading>
            <tilt>45.0</tilt>
            <range>3500000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Western Pacific Conclusion -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>135.0</longitude>
            <latitude>28.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
