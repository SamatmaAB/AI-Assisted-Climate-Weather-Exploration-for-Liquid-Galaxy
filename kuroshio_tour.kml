<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
  <name>Kuroshio Current Guided Tour</name>
  <open>1</open>
  <gx:Tour>
    <name>Kuroshio Current Guided Tour</name>
    <gx:Playlist>

        <!-- Scientific Stop: Western Pacific Overview -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>135.0</longitude>
            <latitude>28.0</latitude>
            <altitude>0.0</altitude>
            <heading>0.0</heading>
            <tilt>45.0</tilt>
            <range>6000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Taiwan & Luzon Strait Origin -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>122.0</longitude>
            <latitude>22.0</latitude>
            <altitude>0.0</altitude>
            <heading>30.0</heading>
            <tilt>50.0</tilt>
            <range>1800000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Taipei 101 Landmark View (Taipei, Taiwan) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>121.562000</longitude>
            <latitude>25.031500</latitude>
            <altitude>150.0</altitude>
            <heading>43.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 1/6: Taipei 101 Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>121.561245</longitude>
            <latitude>25.032419</latitude>
            <altitude>150.0</altitude>
            <heading>63.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 2/6: Taipei 101 Landmark View -->
