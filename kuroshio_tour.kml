            <tilt>95.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 3/6: Tokyo Tower Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>139.742997</longitude>
            <latitude>35.660381</latitude>
            <altitude>90.0</altitude>
            <heading>132.4</heading>
            <tilt>95.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 4/6: Tokyo Tower Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>139.743892</longitude>
            <latitude>35.660942</latitude>
            <altitude>90.0</altitude>
            <heading>152.4</heading>
            <tilt>95.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 5/6: Tokyo Tower Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>139.744969</longitude>
            <latitude>35.661219</latitude>
            <altitude>90.0</altitude>
            <heading>172.4</heading>
            <tilt>95.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 6/6: Tokyo Tower Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>139.746097</longitude>
            <latitude>35.661181</latitude>
            <altitude>90.0</altitude>
            <heading>192.4</heading>
            <tilt>95.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
