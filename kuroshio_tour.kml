            <altitude>150.0</altitude>
            <heading>83.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 3/6: Taipei 101 Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>121.560956</longitude>
            <latitude>25.034662</latitude>
            <altitude>150.0</altitude>
            <heading>103.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 4/6: Taipei 101 Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>121.561457</longitude>
            <latitude>25.035714</latitude>
            <altitude>150.0</altitude>
            <heading>123.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 5/6: Taipei 101 Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>121.562326</longitude>
            <latitude>25.036548</latitude>
            <altitude>150.0</altitude>
            <heading>143.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Partial Orbit Keyframe 6/6: Taipei 101 Landmark View -->
        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>121.563456</longitude>
            <latitude>25.037062</latitude>
            <altitude>150.0</altitude>
            <heading>163.3</heading>
            <tilt>80.0</tilt>
            <roll>0.0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Final Settle Hold: Taipei 101 Landmark View -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- Scientific Stop: Okinawa & East China Sea Path -->
        <gx:FlyTo>
          <gx:duration>9.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>128.0</longitude>
            <latitude>27.0</latitude>
            <altitude>0.0</altitude>
            <heading>45.0</heading>
            <tilt>55.0</tilt>
            <range>1800000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Scientific Stop: Kuroshio Extension off Japan & Tokyo -->
        <gx:FlyTo>
          <gx:duration>11.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>140.0</longitude>
            <latitude>35.0</latitude>
            <altitude>0.0</altitude>
            <heading>60.0</heading>
            <tilt>50.0</tilt>
            <range>2000000.0</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Landmark Approach: Tokyo Tower Landmark View (Tokyo, Japan) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
